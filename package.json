    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.7",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  }
}
