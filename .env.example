# Optional same-origin backend route. Leave empty until real message delivery is configured.
VITE_CONTACT_ENDPOINT=

# Supabase public frontend configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set true only after custom SMTP and email confirmation are configured and tested.
VITE_AUTH_EMAILS_ENABLED=false

# Builds expose only the four variables above. Use an HTTPS Supabase origin
# and a publishable/legacy anon key; secret/service_role keys fail validation.
# Production CSP is generated from this origin. External contact endpoints are rejected.
